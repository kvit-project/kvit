+        expected_hash = hash_block_tokens(
+            sha256_cbor,
+            hashes[0],
+            (3, 4, 5),
+            expected_extra,
+        )
+        assert hashes[1] == expected_hash
+    finally:
+        envs.VLLM_V1_SPANS_ENABLED = original
+
+
